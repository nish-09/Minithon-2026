# Copy to .env (never commit .env). All variables are prefixed NEXA_.

# --- core ---
NEXA_ENVIRONMENT=development            # "production" disables /docs and refuses the default JWT secret
NEXA_DATABASE_URL=sqlite:///./nexa.db   # production: postgresql+psycopg://user:pass@host:5432/nexa
NEXA_JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
NEXA_JWT_EXPIRE_MINUTES=1440
NEXA_CORS_ORIGINS=http://localhost:3000 # comma separated list of web origins
NEXA_BCRYPT_ROUNDS=12
NEXA_SWEEPER_INTERVAL_S=5               # background escalation/expiry sweep, 0 disables

# --- routing policy (all configurable, nothing is hard-coded in the app) ---
NEXA_CIRCLE_WINDOW_NORMAL_S=300         # how long the Trusted Circle gets to answer a normal request
NEXA_CIRCLE_WINDOW_URGENT_S=60          # (urgent requests notify circle + community together; critical never waits)
NEXA_CIRCLE_RADIUS_KM=25
NEXA_COMMUNITY_RADIUS_KM=10
NEXA_MAX_SEARCH_RADIUS_KM=40
NEXA_BROADCAST_SIZE=8                   # helpers alerted at once for urgent/critical
NEXA_NORMAL_NOTIFY_COUNT=3
NEXA_HELPER_WINDOW_NORMAL_S=180
NEXA_HELPER_WINDOW_URGENT_S=60
NEXA_HELPER_WINDOW_CRITICAL_S=45
NEXA_EMERGENCY_NUMBER=112               # shown in NEXA CARE; change for your country
NEXA_AVG_SPEED_KMH=28                   # used for ETA estimates

# --- help credits ---
NEXA_STARTING_CREDITS=20
NEXA_CREDIT_REWARD_PER_HELP=10
NEXA_CREDIT_COST_PER_HELP=10

# --- optional AI services (the app works without them) ---
# Claude for request understanding. Unset => deterministic rule-based understanding.
NEXA_ANTHROPIC_API_KEY=
NEXA_LLM_MODEL=claude-haiku-4-5-20251001
# Local vision model for the first-aid camera check (free; needs Ollama + `ollama pull qwen2.5vl:3b`). Used when no Claude key is set.
NEXA_OLLAMA_URL=http://localhost:11434
NEXA_VISION_MODEL=qwen2.5vl:3b
# Server-side speech-to-text (any OpenAI-compatible /audio/transcriptions endpoint). Unset => browser speech recognition only.
NEXA_STT_URL=
NEXA_STT_API_KEY=
NEXA_STT_MODEL=whisper-1
